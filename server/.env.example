# Server — copy to server/.env and fill in values (never commit .env)

NODE_ENV=development
PORT=3000

# MongoDB Atlas (Step 2+)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/local-drivers?retryWrites=true&w=majority

# JWT for app sessions (Step 3+)
JWT_SECRET=change-me-to-a-long-random-string

# Google Sign-In (Step 3+) — web client id; comma-separate Android id if different
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com

# Image upload signing (Step 4+)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: comma-separated admin emails (Step 5+)
ADMIN_EMAILS=