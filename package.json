{
  "name": "local-drivers",
  "private": true,
  "version": "0.1.0",
  "description": "Local Driver Directory — monorepo (server API + React Native app)",
  "workspaces": [
    "server",
    "app"
  ],
  "scripts": {
    "lint": "eslint server app",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:server": "npm run dev -w server",
    "start:app": "npm run start -w app"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "typescript-eslint": "^8.18.2"
  }
}