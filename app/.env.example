# App — copy to app/.env and fill in (Expo loads EXPO_PUBLIC_* at build time)

# Backend base URL (no trailing slash)
# Emulator: http://10.0.2.2:3000 — physical device: your PC LAN IP, e.g. http://192.168.1.5:3000
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Google OAuth (same Cloud project as server GOOGLE_CLIENT_ID = Web client ID)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=